# Paste your keys after the = sign. No quotes, no spaces.

# Apify: console.apify.com > Settings > API & Integrations > Personal API token
APIFY_TOKEN=paste-apify-token-here

# Anthropic: console.anthropic.com > API Keys > Create Key
ANTHROPIC_API_KEY=paste-anthropic-key-here

# Optional, recommended: a separate key just for tagging, so a big Update can never use up the credit the
# website's answers need. Console > Settings > Workspaces > Create "Tagging", set its monthly spend limit,
# then API Keys > Create Key in that workspace. Leave as is to tag with the key above.
ANTHROPIC_TAG_API_KEY=paste-tagging-key-here
